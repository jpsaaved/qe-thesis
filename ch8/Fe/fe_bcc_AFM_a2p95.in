&control
    calculation   = 'scf',
    prefix        = 'fe_AFM_a2p95',
    pseudo_dir    = '/users/jsaaved1/research/pslibrary.1.0.0/pbe/PSEUDOPOTENTIALS',
    outdir        = './tmp/fe_AFM_a2p95',
/
&system
    ibrav         = 3,
    A             = 2.95,        ! lattice constant
    nat           = 2,
    ntyp          = 2,
    ecutwfc       = 45.0,
    ecutrho       = 360.0,
    occupations   = 'smearing',
    smearing      = 'mp',
    degauss       = 0.02,
    nspin         = 2,
    starting_magnetization(1) = 0.8,   ! Fe1 up
    starting_magnetization(2) = -0.8,  ! Fe2 down
    tot_magnetization         = 0,     ! enforce net AFM
/
&electrons
    conv_thr      = 1.0d-8,
    mixing_beta   = 0.5,
/
ATOMIC_SPECIES
 Fe1 55.845 Fe.pbe-spn-kjpaw_psl.1.0.0.UPF
 Fe2 55.845 Fe.pbe-spn-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS crystal
 Fe1 0.00 0.00 0.00
 Fe2 0.50 0.50 0.50

K_POINTS automatic
 12 12 12 0 0 0

