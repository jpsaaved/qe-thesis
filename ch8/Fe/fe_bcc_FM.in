&control
    calculation   = 'scf',
    prefix        = 'PREFIX',
    pseudo_dir    = '/users/jsaaved1/research/pslibrary.1.0.0/pbe/PSEUDOPOTENTIALS',
    outdir        = 'OUTDIR',
/
&system
    ibrav         = 3,
    A             = AAAA,        ! lattice constant (Å)
    nat           = 1,
    ntyp          = 1,
    ecutwfc       = 45.0,
    ecutrho       = 360.0,
    occupations   = 'smearing',
    smearing      = 'mp',
    degauss       = 0.02,
    nspin         = 2,           ! spin-polarized
    starting_magnetization(1) = 0.8,
/
&electrons
    conv_thr      = 1.0d-8,
    mixing_beta   = 0.3,         ! smaller to keep FM from collapsing
    mixing_mode   = 'local-TF',
/
ATOMIC_SPECIES
 Fe 55.845 Fe.pbe-spn-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS crystal
 Fe 0.00 0.00 0.00

K_POINTS automatic
 12 12 12 0 0 0

